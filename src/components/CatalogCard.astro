---
import type { IconName } from './icons/types';
import Icon from './icons/Icon.astro';
import { Badge } from '@/components/starwind/badge';
import { Button } from '@/components/starwind/button';
import {
  Card,
  CardContent,
  CardFooter,
  CardHeader,
  CardTitle,
} from '@/components/starwind/card';

interface Props {
  label: string;
  title: string;
  href: string;
  buyUrl: string;
  features: string[];
  more?: number;
  icon?: IconName;
  badge?: string;
  variant?: 'essential' | 'popular' | 'limited';
  buyLabel?: string;
  viewLabel?: string;
  maxFeatures?: number;
  /** Featured private cheat: larger type, 2-col feature grid, full-width CTAs (homepage / hub). */
  layout?: 'vertical' | 'horizontal';
  class?: string;
}

const {
  label,
  title,
  href,
  buyUrl,
  features,
  more = 0,
  icon = 'package',
  badge,
  variant,
  buyLabel = 'Buy now',
  viewLabel = 'View details',
  maxFeatures = 10,
  layout = 'vertical',
  class: className,
} = Astro.props;

const isHorizontal = layout === 'horizontal';

const displayFeatures = features.slice(0, maxFeatures);

const statusBadgeIcon = (text: string): IconName => {
  if (/limited/i.test(text)) return 'alert';
  if (/private/i.test(label)) return 'shieldCheck';
  return 'circleCheck';
};
---

<Card
  class:list={[
    'group flex h-full flex-col transition-shadow hover:shadow-md',
    isHorizontal && 'bg-gradient-to-br from-primary/[0.06] via-card to-card',
    className,
  ]}
>
  <CardHeader class:list={['space-y-2.5', isHorizontal && 'pb-1']}>
    <CardTitle class:list={['normal-case leading-snug', isHorizontal ? 'text-2xl font-bold tracking-tight md:text-3xl' : 'text-lg']}>
      <a href={href} class="hover:text-primary">{title}</a>
    </CardTitle>
    <div class="catalog-card__badges flex flex-wrap items-center gap-1.5">
      <Badge tone="primary" appearance="outline" size="sm" class="catalog-card__badge gap-1">
        <Icon name={icon} size={12} class="shrink-0" />
        {label}
      </Badge>
      {
        badge && (
          <Badge
            tone={/limited/i.test(badge) ? 'warning' : 'success'}
            appearance="soft"
            size="sm"
            class="catalog-card__badge gap-1"
          >
            <Icon name={statusBadgeIcon(badge)} size={12} class="shrink-0" />
            {badge}
          </Badge>
        )
      }
      {variant === 'popular' && (
        <Badge tone="primary" appearance="solid" size="sm" class="catalog-card__badge gap-1">
          <Icon name="zap" size={12} class="shrink-0" />
          Popular
        </Badge>
      )}
      {
        variant === 'limited' && !badge?.toLowerCase().includes('limited') && (
          <Badge tone="warning" appearance="outline" size="sm" class="catalog-card__badge gap-1">
            <Icon name="alert" size={12} class="shrink-0" />
            Limited
          </Badge>
        )
      }
    </div>
  </CardHeader>
  <CardContent class:list={['flex-1', isHorizontal && 'pt-0']}>
    <ul
      class:list={[
        'text-muted-foreground',
        isHorizontal
          ? 'grid grid-cols-1 gap-x-10 gap-y-2.5 text-[0.9375rem] leading-snug sm:grid-cols-2'
          : 'space-y-2 text-sm',
      ]}
    >
      {displayFeatures.map((feature) => (
        <li class:list={['flex items-start gap-2.5', isHorizontal && 'break-inside-avoid']}>
          <Icon name="check" size={isHorizontal ? 16 : 14} class="mt-0.5 shrink-0 text-primary/80" />
          <span>{feature}</span>
        </li>
      ))}
      {
        more > 0 && (
          <li
            class:list={[
              'text-muted-foreground',
              isHorizontal ? 'col-span-full mt-1 border-t border-border/60 pt-3 text-xs' : 'text-xs',
            ]}
          >
            +{more} more features in the full product page
          </li>
        )
      }
    </ul>
  </CardContent>
  <CardFooter class:list={['flex flex-col sm:flex-row', isHorizontal ? 'gap-3 pt-1 sm:pt-2' : 'gap-2', isHorizontal && 'mt-2 border-t-0 sm:mt-1']}>
    <Button as="a" href={buyUrl} variant="primary" size={isHorizontal ? 'lg' : 'sm'} class="w-full sm:flex-1">
      {buyLabel}
      <Icon name="arrowRight" size={17} />
    </Button>
    <Button as="a" href={href} variant="outline" size={isHorizontal ? 'lg' : 'sm'} class="w-full sm:flex-1">
      {viewLabel}
      <Icon name="arrowRight" size={17} />
    </Button>
  </CardFooter>
</Card>
