---
import ResponsiveImage from './ResponsiveImage.astro';
import { HERO_IMAGE_SIZES, HERO_IMAGE_WIDTHS } from '../utils/responsiveImage';
import {
  Carousel,
  CarouselContent,
  CarouselItem,
  CarouselNext,
  CarouselPrevious,
} from '@/components/starwind/carousel';

interface Slide {
  src: string;
  alt: string;
  caption: string;
  captionDesc: string;
}

interface Props {
  images: Slide[];
  id: string;
  variant?: 'default' | 'hero';
  desktopOnly?: boolean;
  /** Defer Embla init to idle time (homepage LCP — reduces main-thread work at parse). */
  deferEmblaInit?: boolean;
}

const { images, id, variant = 'default', desktopOnly = false, deferEmblaInit = false } = Astro.props;
const isHero = variant === 'hero';
const imageSizes = isHero ? HERO_IMAGE_SIZES : '(min-width: 1024px) 640px, 100vw';
const imageWidths = isHero ? HERO_IMAGE_WIDTHS : undefined;
---

<div
  class:list={[
    'relative w-full',
    'rounded-xl border border-border bg-card p-2 shadow-sm',
    desktopOnly && 'hidden lg:block',
  ]}
  id={id}
  data-hero-embla-wrap={isHero || undefined}
  data-defer-embla-init={isHero ? (deferEmblaInit ? 'true' : 'false') : undefined}
>
  <Carousel
    autoInit={!isHero}
    data-hero-embla={isHero || undefined}
    opts={{ loop: images.length > 1, align: 'start' }}
    class="w-full"
  >
    <!-- Hero: drop Starwind's -ml-4 / pl-4 slide gutters — they mis-align Embla with align:start and clip the first slide. -->
    <CarouselContent class={isHero ? '!ml-0' : undefined}>
      {images.map((img, i) => (
        <CarouselItem class:list={['basis-full', isHero && '!pl-0']}>
          <figure
            class:list={[
              isHero ? 'aspect-[16/10] overflow-hidden rounded-lg bg-muted/30' : 'overflow-hidden rounded-lg',
            ]}
          >
            <ResponsiveImage
              src={img.src}
              alt={img.alt}
              width={960}
              height={540}
              widths={imageWidths}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchPriority={isHero && i === 0 ? 'high' : undefined}
              sizes={imageSizes}
              desktopOnly={desktopOnly}
              class={isHero ? 'h-full w-full object-cover' : undefined}
            />
            {!isHero && (img.caption || img.captionDesc) && (
              <figcaption class="mt-2 px-1 text-sm text-muted-foreground">
                <strong class="text-foreground">{img.caption}</strong>
                {img.captionDesc && ` — ${img.captionDesc}`}
              </figcaption>
            )}
          </figure>
        </CarouselItem>
      ))}
    </CarouselContent>
    {images.length > 1 && (
      <>
        <CarouselPrevious class:list={[isHero ? 'left-2 top-1/2 z-10 -translate-y-1/2' : 'left-2']} />
        <CarouselNext class:list={[isHero ? 'right-2 top-1/2 z-10 -translate-y-1/2' : 'right-2']} />
      </>
    )}
  </Carousel>
  {isHero && images.length > 1 && (
    <div
      class="pointer-events-none absolute inset-x-2 bottom-3 flex justify-center"
      data-hero-embla-dots
      role="tablist"
      aria-label="Hero slides"
    >
      <div class="pointer-events-auto flex items-center gap-1.5 rounded-full border border-white/10 bg-black/45 px-2.5 py-1.5 backdrop-blur-sm">
        {images.map((_, i) => (
          <button
            type="button"
            role="tab"
            class="hero-embla-dot relative h-2 shrink-0 overflow-hidden rounded-full bg-white/30 transition-[width] duration-300 data-[active=false]:w-2 data-[active=true]:w-9"
            data-hero-embla-dot={i}
            aria-label={`Slide ${i + 1}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            data-active={i === 0 ? 'true' : 'false'}
          >
            <span
              class="hero-embla-progress pointer-events-none absolute inset-y-0 left-0 w-0 rounded-full bg-primary"
              data-hero-embla-progress
              aria-hidden="true"
            />
          </button>
        ))}
      </div>
    </div>
  )}
</div>

{isHero && (
  <script>
    /**
     * Do not use `define:vars` here — with it, Astro leaves raw `import` in HTML so the bundle never loads in production.
     * This script is immediately after the wrapper div; read defer from `data-defer-embla-init` on that node.
     */
    import { setupHeroEmbla } from '@/scripts/hero-embla';
    const wrap = document.currentScript?.previousElementSibling;
    const deferInit =
      wrap instanceof HTMLElement && wrap.hasAttribute('data-defer-embla-init')
        ? wrap.getAttribute('data-defer-embla-init') === 'true'
        : false;
    setupHeroEmbla(deferInit);
  </script>
)}
