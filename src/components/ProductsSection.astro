---
import '../styles/product-cheat-page.css';
import { t } from '../i18n';
import { productPages } from '../data/products';
import { cheatTierIcons, productCategoryIcons } from '../data/sectionIcons';
import SectionHeader from './SectionHeader.astro';
import CatalogCard from './CatalogCard.astro';
import { productPath } from '../utils/path';

interface Props {
  /** Use h2 on the homepage so the hero keeps the only h1. */
  titleHeading?: 'h1' | 'h2';
}

const { titleHeading = 'h1' } = Astro.props as Props;

const s = t.products;

const primaryProduct = productPages.find((p) => p.slug === 'mw4-private-suite');
const utilityProducts = productPages.filter((p) => p.slug !== 'mw4-private-suite');

if (!primaryProduct) {
  throw new Error('ProductsSection: mw4-private-suite missing from productPages');
}

function cardIcon(product: (typeof productPages)[number]) {
  if (product.kind === 'tier') {
    return cheatTierIcons[product.name] ?? 'crosshair';
  }
  return productCategoryIcons[product.category ?? ''] ?? 'package';
}

function cardLabel(product: (typeof productPages)[number]) {
  if (product.kind === 'tier') {
    return product.tier ?? product.name;
  }
  return product.category ?? 'Utility';
}
---

<section id="products" class="py-16 md:py-24" aria-labelledby="products-title" data-reveal>
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeader
      eyebrow={s.eyebrow}
      title={s.title}
      desc={s.subtitle}
      titleId="products-title"
      titleHeading={titleHeading}
    />

    <div class="mt-12 space-y-6">
      <CatalogCard
        class="border-primary/25 ring-1 ring-primary/20"
        label={cardLabel(primaryProduct)}
        title={primaryProduct.title}
        href={productPath(primaryProduct.slug)}
        buyUrl={primaryProduct.buyUrl}
        features={primaryProduct.features}
        more={primaryProduct.more}
        icon={cardIcon(primaryProduct)}
        badge={primaryProduct.badge}
        variant={primaryProduct.variant}
        buyLabel="Buy now"
        viewLabel="View details"
        maxFeatures={5}
      />

      <div class="grid gap-6 md:grid-cols-3">
        {
          utilityProducts.map((product) => (
            <CatalogCard
              label={cardLabel(product)}
              title={product.title}
              href={productPath(product.slug)}
              buyUrl={product.buyUrl}
              features={product.features}
              more={product.more}
              icon={cardIcon(product)}
              badge={product.badge}
              variant={product.variant}
              buyLabel="Buy now"
              viewLabel="View details"
              maxFeatures={5}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>
