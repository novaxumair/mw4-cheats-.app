---
import {
  DEFAULT_IMAGE_WIDTHS,
  defaultWebpSrc,
  isDirectRasterSrc,
  responsiveSrcSet,
} from '../utils/responsiveImage';
import { siteAssetUrl } from '../config/site';

interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  loading?: 'lazy' | 'eager';
  fetchPriority?: 'high' | 'low' | 'auto';
  sizes?: string;
  widths?: readonly number[];
  class?: string;
  desktopOnly?: boolean;
}

const {
  src,
  alt,
  width,
  height,
  loading = 'lazy',
  fetchPriority,
  sizes = '(min-width: 1024px) 640px, 100vw',
  widths = DEFAULT_IMAGE_WIDTHS,
  class: className,
  desktopOnly = false,
} = Astro.props;

const isDirectRaster = isDirectRasterSrc(src);
const isRaster = /\.(png|jpe?g|webp)$/i.test(src);
const resolvedSrc = siteAssetUrl(src);
const srcSet = responsiveSrcSet(src, widths);
const imgSrc = desktopOnly
  ? 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7'
  : defaultWebpSrc(src, widths);
const pictureSizes = desktopOnly ? '(min-width: 1024px) 490px, 1px' : sizes;
const pictureMedia = desktopOnly ? '(min-width: 1024px)' : undefined;
---

{
  isRaster && isDirectRaster ? (
    <img
      src={resolvedSrc}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      decoding="async"
      fetchpriority={fetchPriority}
      class={className}
    />
  ) : isRaster ? (
    <picture>
      <source type="image/webp" srcset={srcSet} sizes={pictureSizes} media={pictureMedia} />
      <img
        src={imgSrc}
        srcset={desktopOnly ? undefined : srcSet}
        alt={alt}
        width={width}
        height={height}
        loading={loading}
        decoding="async"
        fetchpriority={fetchPriority}
        sizes={pictureSizes}
        class={className}
      />
    </picture>
  ) : (
    <img
      src={resolvedSrc}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      decoding="async"
      fetchpriority={fetchPriority}
      class={className}
    />
  )
}
