---
interface Props {
  eyebrow: string;
  title: string;
  desc?: string;
  titleId?: string;
  /** Use h2 when this block sits under an existing page h1 (e.g. FAQ on blog posts). */
  titleHeading?: 'h1' | 'h2';
  centered?: boolean;
  wide?: boolean;
}

const { eyebrow, title, desc, titleId, titleHeading = 'h1', centered = false, wide = false } = Astro.props;

const HeadingTag = titleHeading;
---

<header
  class:list={[
    'section-header space-y-0',
    wide && 'section-header--wide',
    centered && 'mx-auto text-center',
  ]}
>
  <p class="section-header__eyebrow">{eyebrow}</p>
  <HeadingTag id={titleId} class="section-header__title">{title}</HeadingTag>
  {desc ? <p class="section-header__subtitle">{desc}</p> : null}
</header>
