---
import SectionHeader from '../SectionHeader.astro';
import { Prose } from '@/components/starwind/prose';

interface Block {
  type: 'h2' | 'p';
  text: string;
}

interface Props {
  overviewTitle?: string;
  blocks: Block[];
}

const { overviewTitle, blocks } = Astro.props;
---

<section
  class="border-t border-border bg-background py-12 md:py-16"
  aria-labelledby="product-description-title"
  data-reveal
>
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeader
      eyebrow="Overview"
      title={overviewTitle ?? 'Product description'}
      desc="How this build fits ranked, Turbo, and patch-day workflows."
      titleId="product-description-title"
      wide
    />

    <div class="product-detail__narrow mt-8">
      <Prose class="max-w-none">
        {blocks.map((block) => (block.type === 'h2' ? <h2>{block.text}</h2> : <p>{block.text}</p>))}
      </Prose>
    </div>
  </div>
</section>
