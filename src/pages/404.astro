---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import Icon from '../components/icons/Icon.astro';
import { Button } from '@/components/starwind/button';
import { ROUTES } from '../utils/path';

---

<BaseLayout
  title="404 Page Not Found | MW4 Cheats for PC | MW4 Cheat"
  description="That MW4 cheats page is not on mw4cheats.app. Go back to the homepage, open the private cheat, or browse the PC guides for aimbot, ESP, and the HWID spoofer."
  noindex={true}
>
  <section class="py-16 md:py-24" data-reveal>
    <div class="mx-auto max-w-lg px-5 text-center">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary">404</p>
      <h1 class="mt-3 text-3xl font-bold uppercase md:text-4xl">Page not found</h1>
      <p class="mt-4 text-muted-foreground">
        That URL does not exist or may have moved. Head back to the homepage or browse MW4 products.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center">
        <Button as="a" href={ROUTES.home} variant="primary">
          Back to home
          <Icon name="arrowRight" size={17} />
        </Button>
        <Button as="a" href={ROUTES.products} variant="outline">Browse the catalog</Button>
        <Button as="a" href={ROUTES.productsElite} variant="outline">Private cheat</Button>
      </div>
    </div>
  </section>
</BaseLayout>
