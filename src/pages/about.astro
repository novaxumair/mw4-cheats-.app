---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { resolvePageSeo } from '../config/seo';

const seo = resolvePageSeo('/about/');
import LegalPage from '../components/LegalPage.astro';
import { breadcrumbSchema, organizationSchema, webPageSchema } from '../utils/schema';

const content = t.legalPages.about;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    organizationSchema(),
    webPageSchema({
      name: 'About MW4 Cheat — PC cheats, guides & help',
      description: seo.description,
      url: '/about/',
    }),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'About', path: '/about/' },
    ]),
  ]}
>
  <LegalPage
    title={content.title}
    headingTitle="About MW4 Cheat — PC cheats, guides & help"
    description={content.description}
    breadcrumbLabel="About"
    sections={content.sections}
  />
</BaseLayout>
