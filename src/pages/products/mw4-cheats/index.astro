---
import '../../../styles/product-cheat-page.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n';
import { productHub, productPages } from '../../../data/products';
import { cheatTierIcons, productCategoryIcons } from '../../../data/sectionIcons';
import { resolvePageSeo } from '../../../config/seo';
import { breadcrumbSchema, collectionPageSchema, itemListSchema } from '../../../utils/schema';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CatalogCard from '../../../components/CatalogCard.astro';
import { productPath } from '../../../utils/path';

const seo = resolvePageSeo('/products/mw4-cheats/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Products', path: productHub.path },
];

function cardIcon(product: (typeof productPages)[number]) {
  if (product.kind === 'tier') {
    return cheatTierIcons[product.name] ?? 'crosshair';
  }
  return productCategoryIcons[product.category ?? ''] ?? 'package';
}

function cardLabel(product: (typeof productPages)[number]) {
  if (product.kind === 'tier') {
    return product.tier ?? product.name;
  }
  return product.category ?? 'Utility';
}

const primaryProduct = productPages.find((p) => p.slug === 'mw4-private-suite');
const utilityProducts = productPages.filter((p) => p.slug !== 'mw4-private-suite');
if (!primaryProduct) {
  throw new Error('Products hub: mw4-private-suite missing from productPages');
}
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    collectionPageSchema({
      name: productHub.title,
      description: productHub.description,
      url: productHub.path,
    }),
    breadcrumbSchema(breadcrumbs),
    itemListSchema(
      productPages.map((product) => ({
        name: product.title,
        url: productPath(product.slug),
      })),
    ),
  ]}
>
  <section class="py-8 md:py-12" data-reveal>
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />

      <div class="mt-6 max-w-3xl space-y-3">
        <h1 class="text-3xl font-bold uppercase md:text-4xl">{t.products.title}</h1>
        <p class="text-lg text-muted-foreground">{t.products.subtitle}</p>
      </div>

      <div class="mt-10 space-y-6">
        <CatalogCard
          layout="horizontal"
          class="border-primary/25 ring-1 ring-primary/20"
          label={cardLabel(primaryProduct)}
          title={primaryProduct.title}
          href={productPath(primaryProduct.slug)}
          buyUrl={primaryProduct.buyUrl}
          features={primaryProduct.features}
          more={primaryProduct.more}
          icon={cardIcon(primaryProduct)}
          badge={primaryProduct.badge}
          variant={primaryProduct.variant}
          buyLabel="Buy now"
          viewLabel="View details"
          maxFeatures={5}
        />
        <div class="grid gap-6 md:grid-cols-3">
          {utilityProducts.map((product) => (
            <CatalogCard
              label={cardLabel(product)}
              title={product.title}
              href={productPath(product.slug)}
              buyUrl={product.buyUrl}
              features={product.features}
              more={product.more}
              icon={cardIcon(product)}
              badge={product.badge}
              variant={product.variant}
              buyLabel="Buy now"
              viewLabel="View details"
              maxFeatures={5}
            />
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
